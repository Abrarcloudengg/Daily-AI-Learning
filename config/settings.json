{
    "model": "qwen/qwen3-coder",
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "temperature": 0.7,
    "max_tokens": 8000,

    "request_timeout": 180.0,
    "max_retries": 3,
    "retry_backoff": 5.0,
    "retry_max_backoff": 60.0,

    "min_lesson_chars": 1200,
    "require_all_sections": false,

    "lessons_per_run": 1,
    "log_level": "INFO",

    "git_remote": "origin",
    "git_branch": "main",

    "referer": "https://github.com/Abrarcloudengg/Daily-AI-Learning",
    "app_title": "Daily-AI-Learning"
}
