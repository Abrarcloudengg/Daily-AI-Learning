# Copy this file to `.env` and fill in your key.
#
#   cp .env.example .env          # macOS / Linux
#   copy .env.example .env        # Windows
#
# `.env` is listed in .gitignore and must never be committed.
# In GitHub Actions these live under Settings -> Secrets and variables -> Actions.

# Required. Get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. Anything in config/settings.json can be overridden for a single run
# with a DAILY_AI_<KEY> variable.
# DAILY_AI_MODEL=qwen/qwen3-coder
# DAILY_AI_MAX_TOKENS=8000
# DAILY_AI_LESSONS_PER_RUN=1
# DAILY_AI_LOG_LEVEL=INFO
